# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# Database Configuration
# Provide your MongoDB connection string (e.g., mongodb://localhost:27017/insightai or MongoDB Atlas URI)
# If left as 'memory' or if local MongoDB is unavailable during development, an in-memory MongoDB will be used.
MONGODB_URI=mongodb://localhost:27017/insightai

# Session Security
SESSION_SECRET=insightai_super_secret_session_key_replace_in_production_min_32_chars

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# AI Provider Configuration (OpenAI, Gemini, OpenRouter, or any OpenAI-compatible API)
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gemini-3.8-flash
AI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Email / SMTP Configuration (for password reset emails)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM=no-reply@insightai.local

